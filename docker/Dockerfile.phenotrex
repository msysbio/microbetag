# Use official Python 3.8 image
FROM python:3.8-slim

# Set working directory
WORKDIR /app

# Set DeepNOG weights directory to user-writable location
ENV DEEPNOG_WEIGHTS_DIR=/app/deepnog_weights

# --- Upgrade pip and core build tools ---
RUN pip install --upgrade pip setuptools wheel

# --- Install CPU-only PyTorch to avoid CUDA downloads ---
RUN pip install torch==2.3.1+cpu -f https://download.pytorch.org/whl/torch_stable.html

# --- Install system build tools required by shap and other deps ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential g++ && \
    rm -rf /var/lib/apt/lists/*

# --- Finally, install Phenotrex with FASTA extras ---
RUN pip install --default-timeout=120 phenotrex[fasta]

ENV DEEPNOG_WEIGHTS_DIR=/opt/deepnog/weights

# # Pre-download the eggNOG5 level-2 deepencoding weights
# RUN python3 -c "from deepnog.utils import get_weights_path; get_weights_path(database='eggNOG5', level='2', architecture='deepencoding')"

# Set environment variables
ENV DEEPNOG_DATA=/app/data

# Install deepnog
RUN pip install deepnog

# Download weights to /app/data
RUN python3 -c "from deepnog.utils import get_weights_path; get_weights_path(database='eggNOG5', level='2', architecture='deepencoding')"

# Install fixed numpy version
RUN pip install numpy==1.21.6

# Default command (if used with Nextflow, Nextflow will override this anyway)
CMD ["bash"]
